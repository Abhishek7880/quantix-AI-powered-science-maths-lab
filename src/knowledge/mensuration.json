{
  "circle": {
    "name": "Circle", "dimension": "2D",
    "variables": {"r": "radius", "d": "diameter (= 2r)"},
    "formulas": [
      {"label": "Area", "formula": "A = πr²"},
      {"label": "Circumference (perimeter)", "formula": "C = 2πr = πd"},
      {"label": "Diameter", "formula": "d = 2r"}
    ],
    "note": "All points are at the same distance r from the centre."
  },
  "semicircle": {
    "name": "Semicircle", "dimension": "2D",
    "variables": {"r": "radius"},
    "formulas": [
      {"label": "Area", "formula": "A = ½πr²"},
      {"label": "Perimeter (arc + diameter)", "formula": "P = πr + 2r = r(π + 2)"},
      {"label": "Arc length", "formula": "L = πr"}
    ],
    "note": "Half of a circle cut along a diameter."
  },
  "ellipse": {
    "name": "Ellipse (Oval)", "dimension": "2D",
    "variables": {"a": "semi-major axis (half the longest width)", "b": "semi-minor axis (half the shortest width)"},
    "formulas": [
      {"label": "Area", "formula": "A = πab"},
      {"label": "Perimeter (Ramanujan approximation)", "formula": "P ≈ π[3(a + b) − √((3a + b)(a + 3b))]"}
    ],
    "note": "The perimeter of an ellipse has no exact elementary formula; the approximation is very accurate."
  },
  "square": {
    "name": "Square", "dimension": "2D",
    "variables": {"a": "side"},
    "formulas": [
      {"label": "Area", "formula": "A = a²"},
      {"label": "Perimeter", "formula": "P = 4a"},
      {"label": "Diagonal", "formula": "d = a√2"}
    ],
    "note": "Four equal sides and four right angles."
  },
  "rectangle": {
    "name": "Rectangle", "dimension": "2D",
    "variables": {"l": "length", "b": "breadth (width)"},
    "formulas": [
      {"label": "Area", "formula": "A = l × b"},
      {"label": "Perimeter", "formula": "P = 2(l + b)"},
      {"label": "Diagonal", "formula": "d = √(l² + b²)"}
    ],
    "note": "Opposite sides equal, all angles 90°."
  },
  "triangle": {
    "name": "Triangle", "dimension": "2D",
    "variables": {"b": "base", "h": "height (perpendicular to the base)", "a, b, c": "sides", "s": "semi-perimeter = (a + b + c) / 2"},
    "formulas": [
      {"label": "Area", "formula": "A = ½ × b × h"},
      {"label": "Area (Heron's formula)", "formula": "A = √(s(s − a)(s − b)(s − c))"},
      {"label": "Perimeter", "formula": "P = a + b + c"},
      {"label": "Equilateral triangle area", "formula": "A = (√3 / 4) a²"},
      {"label": "Right triangle (Pythagoras)", "formula": "c² = a² + b²"}
    ],
    "note": "Angles add up to 180°."
  },
  "rhombus": {
    "name": "Rhombus", "dimension": "2D",
    "variables": {"d₁, d₂": "diagonals", "a": "side", "h": "height"},
    "formulas": [
      {"label": "Area", "formula": "A = ½ × d₁ × d₂"},
      {"label": "Area (base × height)", "formula": "A = a × h"},
      {"label": "Perimeter", "formula": "P = 4a"},
      {"label": "Side from diagonals", "formula": "a = ½√(d₁² + d₂²)"}
    ],
    "note": "Four equal sides; diagonals bisect each other at 90°."
  },
  "parallelogram": {
    "name": "Parallelogram", "dimension": "2D",
    "variables": {"b": "base", "h": "height (perpendicular distance between the bases)", "a": "slant side"},
    "formulas": [
      {"label": "Area", "formula": "A = b × h"},
      {"label": "Perimeter", "formula": "P = 2(a + b)"}
    ],
    "note": "Opposite sides parallel and equal."
  },
  "trapezium": {
    "name": "Trapezium (Trapezoid)", "dimension": "2D",
    "variables": {"a, b": "parallel sides", "h": "height (distance between the parallel sides)", "c, d": "non-parallel sides"},
    "formulas": [
      {"label": "Area", "formula": "A = ½ (a + b) × h"},
      {"label": "Perimeter", "formula": "P = a + b + c + d"}
    ],
    "note": "Exactly one pair of parallel sides."
  },
  "pentagon": {
    "name": "Regular Pentagon", "dimension": "2D",
    "variables": {"a": "side"},
    "formulas": [
      {"label": "Area", "formula": "A = ¼ √(5(5 + 2√5)) a² ≈ 1.720 a²"},
      {"label": "Perimeter", "formula": "P = 5a"},
      {"label": "Interior angle", "formula": "108°"}
    ],
    "note": "Formulas assume a regular pentagon (all sides and angles equal)."
  },
  "hexagon": {
    "name": "Regular Hexagon", "dimension": "2D",
    "variables": {"a": "side"},
    "formulas": [
      {"label": "Area", "formula": "A = (3√3 / 2) a² ≈ 2.598 a²"},
      {"label": "Perimeter", "formula": "P = 6a"},
      {"label": "Interior angle", "formula": "120°"}
    ],
    "note": "Made of 6 equilateral triangles; formulas assume a regular hexagon."
  },
  "cube": {
    "name": "Cube", "dimension": "3D",
    "variables": {"a": "edge (side)"},
    "formulas": [
      {"label": "Volume", "formula": "V = a³"},
      {"label": "Total surface area", "formula": "TSA = 6a²"},
      {"label": "Lateral surface area", "formula": "LSA = 4a²"},
      {"label": "Space diagonal", "formula": "d = a√3"}
    ],
    "note": "6 equal square faces, 12 edges, 8 vertices."
  },
  "cuboid": {
    "name": "Cuboid (Rectangular box)", "dimension": "3D",
    "variables": {"l": "length", "b": "breadth", "h": "height"},
    "formulas": [
      {"label": "Volume", "formula": "V = l × b × h"},
      {"label": "Total surface area", "formula": "TSA = 2(lb + bh + hl)"},
      {"label": "Lateral surface area", "formula": "LSA = 2h(l + b)"},
      {"label": "Space diagonal", "formula": "d = √(l² + b² + h²)"}
    ],
    "note": "6 rectangular faces, 12 edges, 8 vertices."
  },
  "sphere": {
    "name": "Sphere", "dimension": "3D",
    "variables": {"r": "radius"},
    "formulas": [
      {"label": "Volume", "formula": "V = (4/3) πr³"},
      {"label": "Surface area", "formula": "SA = 4πr²"}
    ],
    "note": "Every point on the surface is at distance r from the centre."
  },
  "hemisphere": {
    "name": "Hemisphere", "dimension": "3D",
    "variables": {"r": "radius"},
    "formulas": [
      {"label": "Volume", "formula": "V = (2/3) πr³"},
      {"label": "Curved surface area", "formula": "CSA = 2πr²"},
      {"label": "Total surface area", "formula": "TSA = 3πr²"}
    ],
    "note": "Half of a sphere; TSA includes the flat circular face (πr²)."
  },
  "cylinder": {
    "name": "Cylinder", "dimension": "3D",
    "variables": {"r": "radius of the base", "h": "height"},
    "formulas": [
      {"label": "Volume", "formula": "V = πr²h"},
      {"label": "Curved surface area", "formula": "CSA = 2πrh"},
      {"label": "Total surface area", "formula": "TSA = 2πr(r + h)"}
    ],
    "note": "Two equal parallel circular bases joined by a curved surface."
  },
  "cone": {
    "name": "Right Circular Cone", "dimension": "3D",
    "variables": {"r": "radius of the base", "h": "height", "l": "slant height"},
    "formulas": [
      {"label": "Volume", "formula": "V = (1/3) πr²h"},
      {"label": "Slant height", "formula": "l = √(r² + h²)"},
      {"label": "Curved surface area", "formula": "CSA = πrl"},
      {"label": "Total surface area", "formula": "TSA = πr(l + r)"}
    ],
    "note": "Volume is one-third of a cylinder with the same base and height."
  },
  "square_pyramid": {
    "name": "Square Pyramid", "dimension": "3D",
    "variables": {"a": "side of the square base", "h": "height", "l": "slant height of a triangular face"},
    "formulas": [
      {"label": "Volume", "formula": "V = (1/3) a²h"},
      {"label": "Slant height", "formula": "l = √(h² + (a/2)²)"},
      {"label": "Lateral surface area", "formula": "LSA = 2al"},
      {"label": "Total surface area", "formula": "TSA = a² + 2al"}
    ],
    "note": "Square base with 4 triangular faces meeting at the apex."
  },
  "triangular_prism": {
    "name": "Triangular Prism", "dimension": "3D",
    "variables": {"b": "base of the triangle", "h": "height of the triangle", "L": "length of the prism", "a, b, c": "sides of the triangle"},
    "formulas": [
      {"label": "Volume", "formula": "V = (½ × b × h) × L"},
      {"label": "Lateral surface area", "formula": "LSA = (a + b + c) × L"},
      {"label": "Total surface area", "formula": "TSA = (a + b + c) × L + b × h"}
    ],
    "note": "Two equal triangular ends joined by three rectangles. TSA = LSA + 2 × (½ × b × h)."
  }
}
