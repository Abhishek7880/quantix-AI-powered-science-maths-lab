# Environment
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Data, weights and results (large / generated / possibly confidential)
dataset/images/**
dataset/labels/**
!dataset/images/**/.gitkeep
!dataset/labels/**/.gitkeep
examples/synthetic_dataset/images/
examples/synthetic_dataset/labels/
examples/synthetic_dataset/*.cache
examples/shapes_dataset/images/
examples/shapes_dataset/labels/
*.cache
models/**
!models/.gitkeep
outputs/**
!outputs/**/.gitkeep
*.pt
*.onnx
datasets/


# Email account for contact alerts (password!)
secrets/

# ...except the two small models the website needs (shape detector 5 MB, handwriting 2.6 MB), so a fresh clone works
!models/*/
!models/registry.json
!models/shapes_mensuration/best.pt
!models/shapes_mensuration/experiment.json
!models/handwriting/symbols.pt
!models/handwriting/symbols.json
!models/pretrained/yolo11n.pt
!models/everyday/everyday.pt
!models/everyday/everyday.json
!models/everyday_ft/best.pt
!models/everyday_ft/classes.json
datasets/everyday_test/

# local / generated
*.log
.claude/

# generated Learn pages (tools/build_seo_pages.py)
build/

# Android app: build outputs and machine-specific paths (signing key lives in secrets/)
android/.gradle/
android/build/
android/app/build/
android/local.properties
# offline copy of the site inside the app, made by tools/build_app_bundle.py
android/app/src/main/assets/site/
!src/web/app/Quantix.apk
